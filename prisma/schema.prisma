// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "mysql"
  url       = env("DATABASE_URL")
}

model Lead {
  id              String      @id @default(cuid())
  name            String? @db.Text
  email           String   @unique
  company         String? @db.Text
  website         String? @db.Text
  phone           String? @db.Text
  whatsapp        String? @db.Text
  country         String? @db.Text
  city            String? @db.Text
  service         String? @db.Text
  goal            String? @db.Text
  message         String? @db.Text
  source          String? @db.Text // homepage-cta, service-cta, free-audit, etc.
  campaign        String? @db.Text
  utmSource       String? @db.Text
  utmMedium       String? @db.Text
  utmCampaign     String? @db.Text
  utmTerm         String? @db.Text
  utmContent      String? @db.Text
  tags            String? @db.Text // comma-separated
  estimatedValue  Float?
  expectedCloseAt DateTime?
  assignedTo      String?     // staff display name / email
  auditScore      Int?
  auditData       String? @db.Text // JSON string of full audit results
  leadScore       Int?         // auto-calculated qualification score (0-100)
  leadTier        String? @db.Text // auto-calculated: HOT, WARM, COLD
  status          LeadStatus  @default(NEW)
  action          LeadAction? // current action label
  actionNote      String? @db.Text
  actionAt        DateTime?
  clientId        String?
  client          Client?     @relation(fields: [clientId], references: [id], onDelete: SetNull)
  followUps       FollowUp[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  meetings        Meeting[]

  @@index([status])
  @@index([createdAt])
  @@index([assignedTo])
  @@index([clientId])
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  CONVERTED
  LOST
  FOLLOW_UP
  IN_PROGRESS
  CLOSED
  ARCHIVED
}

enum LeadAction {
  MADE_CALL
  NO_RESPONSE
  CLOSED
  REMINDER
  FOLLOW_UP
}

model Meeting {
  id          String   @id @default(cuid())
  leadId      String
  lead        Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  name        String @db.Text
  email       String @db.Text
  company     String? @db.Text
  service     String? @db.Text
  date        String @db.Text // ISO date string (yyyy-MM-dd)
  time        String @db.Text // HH:mm
  timezone    String @db.Text   @default("UTC")
  notes       String? @db.Text
  status      String @db.Text   @default("scheduled") // scheduled, completed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Site content stored as key-value pairs for the admin content editor
model SiteContent {
  key       String   @id // e.g. "hero.headline", "contact.email"
  value     String @db.Text
  updatedAt DateTime @updatedAt
}

// Media library — uploaded images and videos
model Media {
  id         String   @id @default(cuid())
  filename   String @db.Text // original filename
  storedName String @db.Text // unique stored filename
  url        String @db.Text // /uploads/<storedName>
  mimeType   String @db.Text // image/png, video/mp4, etc.
  size       Int      // bytes
  altText    String? @db.Text
  title      String? @db.Text
  type       String @db.Text // "image" | "video" | "document"
  createdAt  DateTime @default(now())

  // The media library lists every row newest-first with no take, so this sort
  // is a full scan plus sort without the index.
  @@index([createdAt])
}

// Pages — dynamic pages that can be created/edited/deleted
model Page {
  id       String @id @default(cuid())
  title    String @db.Text
  slug     String @unique // URL slug
  content  String @db.LongText // inline: JSON sections or HTML fragment. document: a complete HTML file
  status   String @db.Text @default("published") // published, draft
  template String @db.Text @default("standard") // standard, landing, about
  // inline = rendered into the page DOM (rich text / HTML fragment, no scripts run).
  // document = rendered in a sandboxed frame as a full HTML file, with <style>
  // and <script> working and shortcodes expanded (see src/lib/shortcodes.ts).
  renderMode String @db.Text  @default("inline")
  schemaJson String? @db.LongText // Schema.org JSON-LD (single JSON string)
  parentId    String?  // for sub-pages
  parent      Page?    @relation("PageHierarchy", fields: [parentId], references: [id])
  children    Page[]   @relation("PageHierarchy")
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// URL redirects — 301/302 rules managed from the admin panel
model Redirect {
  id          String   @id @default(cuid())
  source      String   @unique // source path e.g. /old-page or /old-page?x=1
  destination String @db.Text // target URL (absolute or path)
  statusCode  Int      @default(301) // 301 permanent, 302 temporary
  enabled     Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// Blog posts — dynamic blog articles
model BlogPost {
  id          String    @id @default(cuid())
  title       String @db.Text
  slug        String    @unique
  excerpt     String @db.Text
  content     String @db.Text // JSON string of article sections
  category    String? @db.Text
  tags        String? @db.Text // comma-separated
  author      String    @default("Climbix Team")
  heroImage   String? @db.Text // media URL or gradient class
  readTime    String    @default("5 min read")
  status      String    @default("published") // published, draft
  featured    Boolean   @default(false)
  publishedAt DateTime  @default(now())
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Three call sites filter on status and order by publishedAt (sitemap,
  // /api/blog-posts, lib/blog). Composite so the filter and the sort are both
  // served by the index.
  @@index([status, publishedAt])
}

// Categories — for blog posts and pages
model Category {
  id        String     @id @default(cuid())
  name      String @db.Text
  slug      String     @unique
  type      String @db.Text     @default("blog") // blog, page, industry, service
  parentId  String?    // for subcategories
  parent    Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children  Category[] @relation("CategoryHierarchy")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

// Email log — stores all emails sent by the system
model EmailLog {
  id        String   @id @default(cuid())
  to        String @db.Text // recipient email
  from      String @db.Text   @default("noreply@climbixmarketing.com")
  subject   String @db.Text
  body      String @db.Text // HTML body
  type      String @db.Text // meeting_confirmation, lead_notification, etc.
  status    String @db.Text   @default("sent") // sent, failed
  leadId    String?
  createdAt DateTime @default(now())
}

// ─────────────────────────────────────────────────────────────
// Homepage CMS — admin-managed homepage content & section order
// ─────────────────────────────────────────────────────────────

// Trust badges — small credibility strip items (e.g. "Google Partner")
model TrustBadge {
  id        String   @id @default(cuid())
  label     String @db.Text
  icon      String @db.Text   @default("shield-check") // lucide icon key
  imageUrl  String? @db.Text // optional uploaded partner / certification mark
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// Client logos — logo marquee / grid on the homepage
model ClientLogo {
  id        String   @id @default(cuid())
  name      String @db.Text
  imageUrl  String? @db.Text // optional logo image URL (from media library)
  website   String? @db.Text
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// Client reviews / testimonials
model Testimonial {
  id        String   @id @default(cuid())
  name      String @db.Text
  role      String? @db.Text
  company   String? @db.Text
  quote     String @db.Text
  rating    Int      @default(5) // 1-5 stars
  avatarUrl String? @db.Text
  isActive  Boolean  @default(true)
  featured  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// Marketing offers / promotions (e.g. "Free SEO Audit — Limited Time")
model Offer {
  id          String    @id @default(cuid())
  title       String @db.Text
  description String @db.Text
  badge       String? @db.Text // e.g. "LIMITED TIME", "FREE"
  imageUrl    String? @db.Text // optional uploaded offer artwork
  ctaLabel    String    @default("Claim Offer")
  ctaHref     String @db.Text    @default("#strategy-call")
  expiresAt   DateTime? // optional expiry — hidden automatically after this date
  isActive    Boolean   @default(true)
  position    Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([isActive, position])
}

// Homepage section manager — visibility toggle + position ordering
model HomePageSection {
  id        String   @id @default(cuid())
  key       String   @unique // hero, trust-badges, services, offers, ...
  label     String @db.Text // admin display name
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  updatedAt DateTime @updatedAt
}

// Homepage section content — editable text/items per section (JSON blob)
model SectionContent {
  key       String   @id // matches HomePageSection.key
  data      String @db.Text   @default("{}") // JSON string of editable fields
  updatedAt DateTime @updatedAt
}

// Services — the service catalog shown on the homepage grid, /services
// overview and individual service pages. Seed rows mirror the static
// defaults in src/data/services.ts; admin edits are stored here and
// deep-merged over the defaults when rendering.
model Service {
  id         String   @id @default(cuid())
  slug       String   @unique // URL slug: /services/<slug>
  name       String @db.Text
  shortName  String @db.Text
  tagline    String @db.Text   @default("")
  icon       String @db.Text   @default("search") // lucide icon key (SERVICE_ICONS)
  accent     String   @default("from-brand-500/20 to-brand-700/10")
  border     String @db.Text   @default("border-brand-500/30")
  cardDesc   String @db.Text   @default("") // grid card description
  cardPoints String @db.Text   @default("[]") // JSON array of grid card bullet strings
  data       String @db.Text   @default("{}") // JSON: hero, problem, framework, subServices, process, results, faq, finalCta
  isActive   Boolean  @default(true)
  position   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([isActive, position])
}

// ─────────────────────────────────────────────────────────────
// Header CMS — admin-managed navigation & announcement popup
// ─────────────────────────────────────────────────────────────

// Header navigation links — reorder, activate/deactivate, custom entries
model HeaderLink {
  id        String   @id @default(cuid())
  label     String @db.Text // display label
  href      String @db.Text   @default("#") // anchor or external URL (kind "link")
  kind      String @db.Text   @default("link") // link | services | industries | blog | pricing
  isSystem  Boolean  @default(false) // seeded structural links cannot be deleted
  isActive  Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
}

// Announcement popup — single editable record shown to visitors
model SitePopup {
  id            String   @id @default(cuid())
  title         String   @default("Special Offer")
  message       String @db.Text   @default("")
  badge         String? @db.Text // small pill above the title, e.g. "LIMITED TIME"
  ctaLabel      String? @db.Text
  ctaHref       String? @db.Text
  imageUrl      String? @db.Text
  customHtml    String? @db.Text // rendered in a sandboxed iframe on public pages
  isActive      Boolean  @default(false)
  delaySeconds  Int      @default(5) // auto-show delay after page load
  showEveryDays Int      @default(1) // per-visitor re-show interval (dismiss memory)
  updatedAt     DateTime @updatedAt
}


// ─────────────────────────────────────────────────────────────
// Workflow automation — visual event-driven CRM automations
// ─────────────────────────────────────────────────────────────

model Workflow {
  id          String   @id @default(cuid())
  name        String @db.Text
  description String? @db.Text
  trigger     String   @default("lead.created")
  nodes       String @db.Text   @default("[]") // JSON array of visual nodes
  edges       String @db.Text   @default("[]") // JSON array of node connections
  isActive    Boolean  @default(true)
  version     Int      @default(1)
  lastRunAt   DateTime?
  createdBy   String? @db.Text
  webhookSecret String? @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  runs WorkflowRun[]

  @@index([isActive, trigger])
  @@index([updatedAt])
}

model WorkflowRun {
  id          String    @id @default(cuid())
  workflowId  String
  workflow    Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  trigger     String @db.Text
  triggerId   String? @db.Text
  leadId      String?
  status      String    @default("running") // running|completed|failed|skipped
  logs        String @db.Text    @default("[]")
  error       String? @db.Text
  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([workflowId, startedAt])
  @@index([leadId, startedAt])
  @@index([status, startedAt])
  @@index([startedAt])
}

// ─────────────────────────────────────────────────────────────
// Access control — users, roles & audit trail (Super Admin RBAC)
// ─────────────────────────────────────────────────────────────

// Admin panel users — each belongs to a role (Role.name)
model User {
  id           String    @id @default(cuid())
  name         String @db.Text
  email        String    @unique
  passwordHash String @db.Text // scrypt hash "salt:hex"
  role         String    @default("STAFF") // Role.name
  phone        String? @db.Text
  isActive     Boolean   @default(true)
  sessionVersion Int      @default(0)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([isActive])
}

// Roles — system roles are seeded; custom roles can be created by Super Admin
model Role {
  id          String   @id @default(cuid())
  name        String   @unique // SUPER_ADMIN, ADMIN, SALES_MANAGER, ...
  label       String @db.Text
  description String @db.Text   @default("")
  permissions String @db.Text   @default("[]") // JSON array of permission keys
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isSystem])
}

// Activity log — audit trail of auth events & content mutations
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  userName  String @db.Text   @default("system")
  action    String @db.Text // login, login_failed, lead.update, page.create, ...
  module    String   @default("system") // auth, leads, content, homepage, ...
  details   String @db.Text   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([module])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────
// Business modules — clients, projects, tasks, follow-ups
// ─────────────────────────────────────────────────────────────

// Clients — companies the agency works with
model Client {
  id        String    @id @default(cuid())
  name      String
  company   String? @db.Text
  email     String? @db.Text
  phone     String? @db.Text
  whatsapp  String? @db.Text
  website   String? @db.Text
  industry  String? @db.Text
  country   String? @db.Text
  city      String? @db.Text
  address   String? @db.Text
  status    String    @default("active") // active | inactive | archived
  notes     String? @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  projects Project[]
  leads    Lead[]

  @@index([status])
  @@index([name])
}

// Projects — client engagements
model Project {
  id            String    @id @default(cuid())
  name          String @db.Text
  code          String?   @unique
  description   String? @db.Text
  clientId      String?
  client        Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  managerName   String? @db.Text // display name of responsible staff
  status        String    @default("planning") // planning|pending|active|on_hold|completed|cancelled|archived
  priority      String @db.Text    @default("medium") // low|medium|high|critical
  progress      Int       @default(0) // 0-100
  budget        Float?
  actualCost    Float?
  revenue       Float?
  startDate     DateTime?
  deadline      DateTime?
  notes         String? @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  tasks Task[]

  @@index([status])
  @@index([clientId])
}

// Tasks — project work items
model Task {
  id             String    @id @default(cuid())
  projectId      String?
  project        Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title          String @db.Text
  description    String? @db.Text
  assigneeName   String? @db.Text
  status         String    @default("todo") // todo|in_progress|review|completed|cancelled
  priority       String @db.Text    @default("medium") // low|medium|high|critical
  dueDate        DateTime?
  estimatedHours Float?
  actualHours    Float?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([status])
  @@index([projectId])
}

// Follow-ups — scheduled lead follow-up activities
model FollowUp {
  id          String    @id @default(cuid())
  leadId      String
  lead        Lead      @relation(fields: [leadId], references: [id], onDelete: Cascade)
  staffName   String? @db.Text
  type        String @db.Text    @default("call") // call|whatsapp|email|meeting|sms|other
  scheduledAt DateTime
  notes       String? @db.Text
  result      String? @db.Text
  nextAt      DateTime?
  done        Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([scheduledAt])
  @@index([leadId])
  @@index([done])
}

// Notifications — in-app notification center
model Notification {
  id        String    @id @default(cuid())
  type      String @db.Text    @default("system") // lead_new|lead_assigned|lead_converted|followup_due|task|system
  title     String @db.Text
  message   String? @db.Text
  href      String? @db.Text
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([readAt])
  @@index([createdAt])
}

// Documents — file attachments linked to projects, clients, leads or staff
model Document {
  id          String    @id @default(cuid())
  name        String @db.Text
  storedName  String    @unique
  url         String @db.Text
  mimeType    String @db.Text
  size        Int       // bytes
  category    String    @default("general") // general|contract|proposal|invoice|report|design|other
  uploadedBy  String @db.Text    @default("system") // display name of uploading user
  relatedType String?   // project|client|lead|staff
  relatedId   String?
  relatedName String? @db.Text // denormalized label for quick display
  notes       String? @db.Text
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
  @@index([relatedType])
  @@index([relatedId])
  @@index([createdAt])
}

// Settings — key/value application configuration (general, branding, security, email, seo)
model Setting {
  key       String   @id // e.g. "general.appName", "security.maxLoginAttempts"
  value     String @db.Text   @default("") // JSON or plain string
  updatedAt DateTime @updatedAt
}

// Password reset tokens — single-use, expire after 1 hour
model PasswordReset {
  id        String    @id @default(cuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

